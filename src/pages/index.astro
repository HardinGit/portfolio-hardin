---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <div style="padding-top: 3rem;">
    <p style="color: var(--muted); margin-bottom: 0.5rem;">Halo, Saya ini</p>
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Hardin</h1>
    <p style="font-size: 1.1rem; color: var(--muted); max-width: 480px; margin-bottom: 2rem;">
      Mahasiswa Areta
    </p>
    <div style="display: flex; gap: 1rem;">
      <a href={`${import.meta.env.BASE_URL}/blog`} style="background: var(--accent); color: white; padding: 0.6rem 1.2rem; border-radius: 6px;">Blog</a>
      <a href={`${import.meta.env.BASE_URL}/about`} style="background: var(--accent); color: white; padding: 0.6rem 1.2rem; border-radius: 6px;">Tentang Saya</a>
    </div>
  </div>
</BaseLayout>