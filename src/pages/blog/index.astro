---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = Object.values(
  import.meta.glob('./posts/*.md', { eager: true })
);

const sorted = posts.sort((a, b) =>
  new Date(b.frontmatter.date) - new Date(a.frontmatter.date)
);
---
<BaseLayout title="Blog">
  <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Blog</h1>
  <p style="color: var(--muted); margin-bottom: 2.5rem;">Catatan pembelajaran di perkuliahan.</p>

  <div style="display: flex; flex-direction: column; gap: 2rem;">
    {sorted.map(post => (
      <a href={post.url} style="color: inherit; text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 2rem;">
        <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 0.4rem;">{post.frontmatter.date}</p>
        <h2 style="font-size: 1.2rem; margin-bottom: 0.5rem;">{post.frontmatter.title}</h2>
        <p style="color: var(--muted);">{post.frontmatter.description}</p>
      </a>
    ))}
  </div>
</BaseLayout>