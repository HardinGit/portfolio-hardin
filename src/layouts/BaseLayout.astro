---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Hardin</title>
    <link rel="stylesheet" href="/portfolio-hardin/styles/global.css" />
  </head>
  <body>
    <header style="border-bottom: 1px solid var(--border); padding: 1.2rem 0;">
      <nav style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <a href={`${import.meta.env.BASE_URL}/`} style="font-weight: bold; color: var(--text); font-size: 1.1rem;">Hardin</a>
        <div style="display: flex; gap: 1.5rem;">
         <a href={`${import.meta.env.BASE_URL}/about`}>About</a>
         <a href={`${import.meta.env.BASE_URL}/blog`}>Blog</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer style="border-top: 1px solid var(--border); text-align: center; padding: 2rem; color: var(--muted); font-size: 0.875rem;">
      © {new Date().getFullYear()} Hardin
    </footer>
  </body>
</html>