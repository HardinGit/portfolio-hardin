---
const { frontmatter } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} — Hardin</title>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles/global.css`} />
  </head>
  <body>
    <header style="border-bottom: 1px solid var(--border); padding: 1.2rem 0;">
      <nav style="max-width: var(--max-w); margin: 0 auto; padding: 0 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <a href="/portfolio-hardin/" style="font-weight: bold; color: var(--text); font-size: 1.1rem;">Timurtas</a>
        <div style="display: flex; gap: 1.5rem;">
          <a href="/portfolio-hardin/about">About</a>
          <a href="/portfolio-hardin/blog">Blog</a>
        </div>
      </nav>
    </header>
    <main>
      <a href="/portfolio-hardin/blog" style="color: var(--muted); font-size: 0.875rem;">← Back to blog</a>
      <article style="margin-top: 2rem;">
        <p style="color: var(--muted); font-size: 0.875rem; margin-bottom: 0.5rem;">{frontmatter.date}</p>
        <h1 style="font-size: 2rem; margin-bottom: 2rem; line-height: 1.3;">{frontmatter.title}</h1>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
    <footer style="border-top: 1px solid var(--border); text-align: center; padding: 2rem; color: var(--muted); font-size: 0.875rem;">
      © {new Date().getFullYear()} Hardin
    </footer>
  </body>
</html>